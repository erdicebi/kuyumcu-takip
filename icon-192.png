export const money = (value: number) => new Intl.NumberFormat("tr-TR", { style: "currency", currency: "TRY", maximumFractionDigits: 2 }).format(value || 0);
export const number = (value: number, digits = 3) => new Intl.NumberFormat("tr-TR", { maximumFractionDigits: digits }).format(value || 0);
export const dateTime = (value: string) => new Intl.DateTimeFormat("tr-TR", { dateStyle: "short", timeStyle: "short" }).format(new Date(value));
